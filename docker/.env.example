# =====================================================================
# HTPT - MQTT credentials (template)
# Copy file này thành .env rồi sửa password:
#     cp .env.example .env
# File .env thật sẽ bị .gitignore - không commit lên git
# =====================================================================

# ESP32_A (Sender) - đọc DHT11, gửi data
MQTT_USER_ESP32_A=esp32_a
MQTT_PASS_ESP32_A=esp32a_pass_2026

# ESP32_B (Receiver) - điều khiển LED
MQTT_USER_ESP32_B=esp32_b
MQTT_PASS_ESP32_B=esp32b_pass_2026

# Web server Node.js
MQTT_USER_WEB=webserver
MQTT_PASS_WEB=web_pass_2026

# Admin - dùng cho mosquitto_sub/pub debug
MQTT_USER_ADMIN=admin
MQTT_PASS_ADMIN=admin_pass_2026
