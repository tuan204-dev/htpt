[
  {
    "id": "tab_htpt",
    "type": "tab",
    "label": "HTPT - Reliable MQTT Demo",
    "disabled": false,
    "info": "Đồ án Hệ thống phân tán\nReliable Message Delivery giữa 2 ESP32 qua MQTT"
  },
  {
    "id": "mqtt_broker_cfg",
    "type": "mqtt-broker",
    "name": "Mosquitto local",
    "broker": "localhost",
    "port": "1883",
    "clientid": "node-red-htpt",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "ui_base",
    "type": "ui_base",
    "theme": {
      "name": "theme-light",
      "lightTheme": {
        "default": "#0094CE",
        "baseColor": "#0094CE",
        "baseFont": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif"
      }
    },
    "site": {
      "name": "HTPT Demo",
      "hideToolbar": "false",
      "allowSwipe": "false",
      "lockMenu": "false",
      "allowTempTheme": "true",
      "dateFormat": "DD/MM/YYYY",
      "sizes": { "sx": 48, "sy": 48, "gx": 6, "gy": 6, "cx": 6, "cy": 6, "px": 0, "py": 0 }
    }
  },
  { "id": "tab_ui", "type": "ui_tab", "name": "HTPT", "icon": "dashboard", "order": 1, "disabled": false, "hidden": false },
  { "id": "grp_sensor",  "type": "ui_group", "name": "1. Dữ liệu cảm biến (real-time)",  "tab": "tab_ui", "order": 1, "disp": true, "width": 12, "collapse": false },
  { "id": "grp_stats_a", "type": "ui_group", "name": "2. Thống kê ESP32_A (Sender)",     "tab": "tab_ui", "order": 2, "disp": true, "width": 12, "collapse": false },
  { "id": "grp_stats_b", "type": "ui_group", "name": "3. Thống kê ESP32_B (Receiver)",   "tab": "tab_ui", "order": 3, "disp": true, "width": 12, "collapse": false },
  { "id": "grp_chart",   "type": "ui_group", "name": "4. Biểu đồ sequence number",        "tab": "tab_ui", "order": 4, "disp": true, "width": 12, "collapse": false },
  { "id": "grp_ctl",     "type": "ui_group", "name": "5. Điều khiển demo",                "tab": "tab_ui", "order": 5, "disp": true, "width": 12, "collapse": false },
  { "id": "grp_log",     "type": "ui_group", "name": "6. Nhật ký sự kiện",                "tab": "tab_ui", "order": 6, "disp": true, "width": 12, "collapse": false },

  {
    "id": "mqtt_in_stats_a",
    "type": "mqtt in",
    "z": "tab_htpt",
    "name": "monitor/stats/A",
    "topic": "monitor/stats/A",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_cfg",
    "x": 130, "y": 80,
    "wires": [["fn_split_stats_a"]]
  },
  {
    "id": "fn_split_stats_a",
    "type": "function",
    "z": "tab_htpt",
    "name": "Tách trường stats A",
    "func": "// payload: {sent_total, unique_seq, dropped, retries, ack_ok, failed, drop_rate}\nconst s = msg.payload;\nreturn [\n  { topic: 'A.unique_seq', payload: s.unique_seq },\n  { topic: 'A.sent_total', payload: s.sent_total },\n  { topic: 'A.dropped',    payload: s.dropped },\n  { topic: 'A.retries',    payload: s.retries },\n  { topic: 'A.ack_ok',     payload: s.ack_ok },\n  { topic: 'A.failed',     payload: s.failed }\n];",
    "outputs": 6,
    "x": 350, "y": 80,
    "wires": [
      ["ui_num_unique"],
      ["ui_num_sent"],
      ["ui_num_dropped"],
      ["ui_num_retries"],
      ["ui_num_ack_ok"],
      ["ui_num_failed"]
    ]
  },
  { "id": "ui_num_unique",  "type": "ui_text", "z": "tab_htpt", "group": "grp_stats_a", "order": 1, "width": 2, "height": 1, "name": "", "label": "Unique seq",     "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 40,  "wires": [] },
  { "id": "ui_num_sent",    "type": "ui_text", "z": "tab_htpt", "group": "grp_stats_a", "order": 2, "width": 2, "height": 1, "name": "", "label": "Sent total",     "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 80,  "wires": [] },
  { "id": "ui_num_dropped", "type": "ui_text", "z": "tab_htpt", "group": "grp_stats_a", "order": 3, "width": 2, "height": 1, "name": "", "label": "Drop-sim",       "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 120, "wires": [] },
  { "id": "ui_num_retries", "type": "ui_text", "z": "tab_htpt", "group": "grp_stats_a", "order": 4, "width": 2, "height": 1, "name": "", "label": "Retries",        "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 160, "wires": [] },
  { "id": "ui_num_ack_ok",  "type": "ui_text", "z": "tab_htpt", "group": "grp_stats_a", "order": 5, "width": 2, "height": 1, "name": "", "label": "ACK OK",         "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 200, "wires": [] },
  { "id": "ui_num_failed",  "type": "ui_text", "z": "tab_htpt", "group": "grp_stats_a", "order": 6, "width": 2, "height": 1, "name": "", "label": "Failed (lost)",  "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 240, "wires": [] },

  {
    "id": "mqtt_in_stats_b",
    "type": "mqtt in",
    "z": "tab_htpt",
    "name": "monitor/stats/B",
    "topic": "monitor/stats/B",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_cfg",
    "x": 130, "y": 320,
    "wires": [["fn_split_stats_b"]]
  },
  {
    "id": "fn_split_stats_b",
    "type": "function",
    "z": "tab_htpt",
    "name": "Tách trường stats B",
    "func": "const s = msg.payload;\nreturn [\n  { topic: 'B.received',   payload: s.received_total },\n  { topic: 'B.ok',         payload: s.ok },\n  { topic: 'B.duplicate',  payload: s.duplicate },\n  { topic: 'B.ooo',        payload: s.out_of_order },\n  { topic: 'B.corrupt',    payload: s.corrupt },\n  { topic: 'B.ack_sent',   payload: s.ack_sent },\n  { topic: 'B.ack_dropped',payload: s.ack_dropped },\n  { topic: 'B.expected',   payload: s.expected_seq }\n];",
    "outputs": 8,
    "x": 350, "y": 320,
    "wires": [
      ["ui_b_received"],
      ["ui_b_ok"],
      ["ui_b_dup"],
      ["ui_b_ooo"],
      ["ui_b_corrupt"],
      ["ui_b_ack_sent"],
      ["ui_b_ack_drop"],
      ["ui_b_expected"]
    ]
  },
  { "id": "ui_b_received","type": "ui_text", "z": "tab_htpt", "group": "grp_stats_b", "order": 1, "width": 2, "height": 1, "name": "", "label": "Received",     "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 280, "wires": [] },
  { "id": "ui_b_ok",      "type": "ui_text", "z": "tab_htpt", "group": "grp_stats_b", "order": 2, "width": 2, "height": 1, "name": "", "label": "OK processed", "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 320, "wires": [] },
  { "id": "ui_b_dup",     "type": "ui_text", "z": "tab_htpt", "group": "grp_stats_b", "order": 3, "width": 2, "height": 1, "name": "", "label": "Duplicate",    "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 360, "wires": [] },
  { "id": "ui_b_ooo",     "type": "ui_text", "z": "tab_htpt", "group": "grp_stats_b", "order": 4, "width": 2, "height": 1, "name": "", "label": "Out-of-order", "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 400, "wires": [] },
  { "id": "ui_b_corrupt", "type": "ui_text", "z": "tab_htpt", "group": "grp_stats_b", "order": 5, "width": 2, "height": 1, "name": "", "label": "Corrupt",      "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 440, "wires": [] },
  { "id": "ui_b_ack_sent","type": "ui_text", "z": "tab_htpt", "group": "grp_stats_b", "order": 6, "width": 2, "height": 1, "name": "", "label": "ACK sent",     "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 480, "wires": [] },
  { "id": "ui_b_ack_drop","type": "ui_text", "z": "tab_htpt", "group": "grp_stats_b", "order": 7, "width": 2, "height": 1, "name": "", "label": "ACK dropped",  "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 520, "wires": [] },
  { "id": "ui_b_expected","type": "ui_text", "z": "tab_htpt", "group": "grp_stats_b", "order": 8, "width": 2, "height": 1, "name": "", "label": "Expected next",  "format": "{{msg.payload}}", "layout": "row-spread", "x": 620, "y": 560, "wires": [] },

  {
    "id": "mqtt_in_processed",
    "type": "mqtt in",
    "z": "tab_htpt",
    "name": "monitor/processed",
    "topic": "monitor/processed",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_cfg",
    "x": 130, "y": 600,
    "wires": [["fn_split_processed"]]
  },
  {
    "id": "fn_split_processed",
    "type": "function",
    "z": "tab_htpt",
    "name": "Tách temp/humid",
    "func": "return [\n  { payload: msg.payload.temp },\n  { payload: msg.payload.humid },\n  { payload: msg.payload.led_main }\n];",
    "outputs": 3,
    "x": 350, "y": 600,
    "wires": [["ui_gauge_temp"], ["ui_gauge_humid"], ["ui_led_main"]]
  },
  {
    "id": "ui_gauge_temp",
    "type": "ui_gauge",
    "z": "tab_htpt",
    "name": "Nhiệt độ",
    "group": "grp_sensor",
    "order": 1, "width": 4, "height": 4,
    "gtype": "gage",
    "title": "Nhiệt độ (°C)",
    "label": "°C",
    "format": "{{value}}",
    "min": 0, "max": 50,
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "25", "seg2": "32",
    "x": 620, "y": 580, "wires": []
  },
  {
    "id": "ui_gauge_humid",
    "type": "ui_gauge",
    "z": "tab_htpt",
    "name": "Độ ẩm",
    "group": "grp_sensor",
    "order": 2, "width": 4, "height": 4,
    "gtype": "gage",
    "title": "Độ ẩm (%)",
    "label": "%",
    "format": "{{value}}",
    "min": 0, "max": 100,
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "40", "seg2": "70",
    "x": 620, "y": 620, "wires": []
  },
  {
    "id": "ui_led_main",
    "type": "ui_text",
    "z": "tab_htpt",
    "group": "grp_sensor",
    "order": 3, "width": 4, "height": 2,
    "name": "LED chính",
    "label": "LED chính (B)",
    "format": "{{msg.payload}}",
    "layout": "row-center",
    "x": 620, "y": 660, "wires": []
  },

  {
    "id": "mqtt_in_received",
    "type": "mqtt in",
    "z": "tab_htpt",
    "name": "monitor/received",
    "topic": "monitor/received",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_cfg",
    "x": 130, "y": 740,
    "wires": [["fn_chart_received", "fn_log_received"]]
  },
  {
    "id": "fn_chart_received",
    "type": "function",
    "z": "tab_htpt",
    "name": "Chart payload",
    "func": "const status = msg.payload.status || 'OK';\nconst seq = msg.payload.seq;\n// 1 series per status, để chart phân loại bằng màu\nreturn { topic: status, payload: seq };",
    "outputs": 1,
    "x": 350, "y": 720,
    "wires": [["ui_chart_seq"]]
  },
  {
    "id": "ui_chart_seq",
    "type": "ui_chart",
    "z": "tab_htpt",
    "name": "Sequence chart",
    "group": "grp_chart",
    "order": 1, "width": 12, "height": 6,
    "label": "Sequence number theo thời gian (phân loại theo trạng thái)",
    "chartType": "line",
    "legend": "true",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Đang chờ dữ liệu...",
    "dot": true,
    "ymin": "", "ymax": "",
    "removeOlder": "5",
    "removeOlderPoints": "200",
    "removeOlderUnit": "60",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": ["#1f77b4", "#ff7f0e", "#d62728", "#9467bd", "#2ca02c"],
    "outputs": 1,
    "x": 620, "y": 720, "wires": [[]]
  },
  {
    "id": "fn_log_received",
    "type": "function",
    "z": "tab_htpt",
    "name": "Format log",
    "func": "const p = msg.payload;\nconst t = new Date().toLocaleTimeString();\nconst line = `[${t}] RECV seq=${p.seq} expected=${p.expected} status=${p.status}`;\nlet hist = context.get('hist') || [];\nhist.unshift(line);\nif (hist.length > 30) hist = hist.slice(0, 30);\ncontext.set('hist', hist);\nreturn { payload: hist.join('\\n') };",
    "outputs": 1,
    "x": 350, "y": 760,
    "wires": [["ui_log"]]
  },
  {
    "id": "ui_log",
    "type": "ui_template",
    "z": "tab_htpt",
    "group": "grp_log",
    "name": "Log 30 sự kiện gần nhất",
    "order": 1, "width": 12, "height": 8,
    "format": "<pre style=\"font-size:11px; line-height:1.3; max-height:300px; overflow:auto; background:#1e1e1e; color:#cfcfcf; padding:8px; border-radius:4px;\">{{msg.payload}}</pre>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 620, "y": 760, "wires": [[]]
  },

  {
    "id": "ui_slider_drop",
    "type": "ui_slider",
    "z": "tab_htpt",
    "name": "Drop rate (A)",
    "label": "Drop rate ESP32_A (giả lập mất gói data)",
    "tooltip": "0 = không drop, 1 = drop hết",
    "group": "grp_ctl",
    "order": 1, "width": 6, "height": 1,
    "passthru": true, "outs": "end",
    "topic": "control/drop_rate",
    "min": 0, "max": 1, "step": "0.05",
    "x": 130, "y": 880, "wires": [["mqtt_out_drop"]]
  },
  {
    "id": "mqtt_out_drop",
    "type": "mqtt out",
    "z": "tab_htpt",
    "name": "→ control/drop_rate",
    "topic": "control/drop_rate",
    "qos": "0", "retain": "true",
    "broker": "mqtt_broker_cfg",
    "x": 400, "y": 880, "wires": []
  },
  {
    "id": "ui_slider_ack_drop",
    "type": "ui_slider",
    "z": "tab_htpt",
    "name": "ACK drop rate (B)",
    "label": "ACK drop rate ESP32_B (giả lập mất ACK)",
    "tooltip": "0 = không drop ACK, 1 = drop hết ACK",
    "group": "grp_ctl",
    "order": 2, "width": 6, "height": 1,
    "passthru": true, "outs": "end",
    "topic": "control/ack_drop_rate",
    "min": 0, "max": 1, "step": "0.05",
    "x": 130, "y": 920, "wires": [["mqtt_out_ack_drop"]]
  },
  {
    "id": "mqtt_out_ack_drop",
    "type": "mqtt out",
    "z": "tab_htpt",
    "name": "→ control/ack_drop_rate",
    "topic": "control/ack_drop_rate",
    "qos": "0", "retain": "true",
    "broker": "mqtt_broker_cfg",
    "x": 400, "y": 920, "wires": []
  },
  {
    "id": "ui_slider_threshold",
    "type": "ui_slider",
    "z": "tab_htpt",
    "name": "Temp threshold",
    "label": "Ngưỡng nhiệt độ để bật LED chính (°C)",
    "tooltip": "Khi nhiệt độ vượt ngưỡng, LED_MAIN của ESP32_B bật",
    "group": "grp_ctl",
    "order": 3, "width": 6, "height": 1,
    "passthru": true, "outs": "end",
    "topic": "control/threshold",
    "min": 15, "max": 40, "step": "1",
    "x": 130, "y": 960, "wires": [["mqtt_out_threshold"]]
  },
  {
    "id": "mqtt_out_threshold",
    "type": "mqtt out",
    "z": "tab_htpt",
    "name": "→ control/threshold",
    "topic": "control/threshold",
    "qos": "0", "retain": "true",
    "broker": "mqtt_broker_cfg",
    "x": 400, "y": 960, "wires": []
  },

  {
    "id": "btn_reset_log",
    "type": "ui_button",
    "z": "tab_htpt",
    "name": "Reset log",
    "group": "grp_ctl",
    "order": 4, "width": 3, "height": 1,
    "passthru": false,
    "label": "Xoá log",
    "tooltip": "Xoá toàn bộ log đang hiển thị",
    "color": "", "bgcolor": "",
    "icon": "delete",
    "payload": "", "payloadType": "str",
    "topic": "reset", "topicType": "str",
    "x": 130, "y": 1000, "wires": [["fn_reset_log"]]
  },
  {
    "id": "fn_reset_log",
    "type": "function",
    "z": "tab_htpt",
    "name": "Clear log buffer",
    "func": "// reset context của node fn_log_received\nflow.set('reset_log', Date.now());\nreturn { payload: '' };",
    "outputs": 1,
    "x": 350, "y": 1000, "wires": [["ui_log"]]
  }
]
