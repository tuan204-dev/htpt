# ----- OS -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ----- Editor / IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# ----- Node.js (web/) -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak
.npm/
.yarn/
.pnp.*
.env
.env.local
.env.*.local

# ----- Arduino / ESP32 build artifacts -----
build/
*.bin
*.elf
*.hex
*.map
.pio/
.pioenvs/
.piolibdeps/
.vscode/arduino.json
.vscode/c_cpp_properties.json
sketch.json
*.ino.cpp

# ----- Mosquitto runtime -----
broker/mosquitto_data/
broker/*.db
broker/mosquitto.log
mosquitto.pid

# ----- Docker -----
docker/.env
docker/data/
docker/log/
docker/mosquitto.passwd   # file password đã hash - sinh từ .env, không commit

# ----- Node-RED runtime -----
nodered/.config.*
nodered/.flows.json.backup
nodered/.sessions.json
nodered/.flows_cred.json
nodered/lib/
nodered/node_modules/

# ----- Logs -----
*.log
logs/

# ----- Secrets (đề phòng vô tình commit credentials WiFi/MQTT) -----
secrets.h
credentials.h
config.local.*

# ----- File tạm của Office / báo cáo -----
*.tmp
*.bak
*.orig
~$*.docx
~$*.xlsx
*.pdf.lock
report/draft/
# Lưu ý: KHÔNG ignore *.pdf/*.docx cuối cùng trong report/
# (báo cáo nộp thường nên commit lên git để có lịch sử).
# Nếu muốn ignore, bỏ comment 2 dòng dưới:
# report/*.docx
# report/*.pdf
